# Database
DATABASE_URL="file:./dev.db"

# Authentication
AUTH_SECRET="change-me-to-a-random-string-at-least-32-chars"
JWT_EXPIRES_IN="7d"

# AI Provider (optional - app works without this using fallback analysis)
AI_API_KEY=""
AI_PROVIDER="gemini"

# App
NEXT_PUBLIC_APP_NAME="CareerPilot"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# File Upload
MAX_FILE_SIZE_MB="5"
