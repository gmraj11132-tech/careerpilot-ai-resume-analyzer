# Database
DATABASE_URL="file:./dev.db"

# Authentication
AUTH_SECRET="change-me-to-a-random-string-at-least-32-chars"
JWT_EXPIRES_IN="7d"

# AI Providers (optional - app works 100% offline using the built-in Deterministic Heuristic Engine)
AI_PROVIDER="google" # Options: google, openai, anthropic, groq, fallback
GEMINI_API_KEY=""    # For Google Gemini (gemini-2.0-flash, gemini-1.5-pro)
OPENAI_API_KEY=""    # For OpenAI (gpt-4o, gpt-4o-mini)
ANTHROPIC_API_KEY="" # For Anthropic Claude (claude-3-5-sonnet, claude-3-haiku)
GROQ_API_KEY=""      # For Groq (llama-3.3-70b, deepseek-r1)
AI_API_KEY=""        # Generic fallback API key

# App
NEXT_PUBLIC_APP_NAME="CareerPilot"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# File Upload
MAX_FILE_SIZE_MB="5"
